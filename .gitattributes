# Normalize line endings so Windows checkouts (CRLF) don't show every file as modified.
* text=auto

# Scripts that run on Linux must always be LF
*.sh       text eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf

# Binary files: never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.pdf  binary
