# ── Application ─────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Falcon Pickleball Court
APP_URL=http://localhost/System/pickleball/pickleball-fixed

# ── Database ───────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=falcon
DB_USER=falcon_app
DB_PASS=secret

# Docker Compose database password (keep this value in .env only)
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ── Optional Railway / Postgres URL ─────────────────────────────────
# DATABASE_URL=postgres://user:password@postgres:5432/falcon

# ── Security ───────────────────────────────────────────────────────
TRUSTED_PROXY_IPS=

# ── Cloudinary / External Uploads ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Deployment helpers ─────────────────────────────────────────────
RAILWAY_ENVIRONMENT=production
IS_PRODUCTION=1

# ── Backups (see scripts/backup.sh, scripts/restore.sh, docs/BACKUPS.md) ───
# Railway's disk is ephemeral — anything written to local disk vanishes on
# the next redeploy/restart. A backup that only lives on the same disk as
# the database it's backing up is not disaster recovery. BACKUP_S3_BUCKET
# and friends are REQUIRED (any S3-compatible provider: AWS S3, Cloudflare
# R2, Backblaze B2, etc.) — without them, scripts/backup.sh will refuse to
# run rather than silently produce backups nobody can retrieve later.
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Error alerting (see config/error_handler.php, docs/ALERTING.md) ────────
# Slack incoming webhook URL (or any endpoint that accepts a JSON {"text":...}
# POST — Discord, Teams, Google Chat, a custom endpoint) to get pinged when
# the app throws a 500 or logs an E_ERROR, instead of finding out from a
# customer. Leave blank to disable (errors still get logged to
# storage/logs/php_errors.log either way).
ALERT_WEBHOOK_URL=

# Used for: registration verification codes, forgot-password codes,
# booking/topup notifications, and login security alerts.
# Gmail example: use an "App Password" (not your normal Gmail password) —
# https://myaccount.google.com/apppasswords
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPT=tls
FROM_EMAIL=noreply@falconcourt.app
FROM_NAME=Falcon Pickleball Court
