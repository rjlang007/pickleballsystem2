# ── Application ─────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Padol Pickleball Court
APP_URL=http://localhost/pickleball

# ── Database ───────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=falcon
DB_USER=falcon_app
DB_PASS=secret

# ── Optional Railway / Postgres URL ─────────────────────────────────
# DATABASE_URL=postgres://user:password@postgres:5432/falcon

# ── Security ───────────────────────────────────────────────────────
TRUSTED_PROXY_IPS=

# ── Cloudinary / External Uploads ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Deployment helpers ─────────────────────────────────────────────
RAILWAY_ENVIRONMENT=production
IS_PRODUCTION=1
